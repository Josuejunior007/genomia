APP_NAME=GenomAI API
APP_ENV=development

# Use a PostgreSQL SQLAlchemy URL com um usuário dedicado e somente leitura (ex.: genomai_readonly).
# DB_READ_ONLY=true não restringe privilégios no PostgreSQL; veja docs/postgres-read-only.md.
# Keep real credentials in your local .env
# or secret manager; never commit passwords, hostnames, or project identifiers.
# Example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE

DB_SCHEMA=public
DB_READ_ONLY=true
AI_ENABLED=false
