APP_NAME=GenomAI API
APP_ENV=development

# Use a role PostgreSQL dedicada e somente leitura, nunca a role administrativa.
# Defina a senha pelo painel Supabase e guarde a URL no .env local/secret manager.
# Exemplo sem valores reais:
# postgresql+psycopg://genomia_reader_app:<senha>@<host>:5432/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg://genomia_reader_app:<senha>@<host>:5432/postgres?sslmode=require

DB_SCHEMA=public
# Indicador da aplicação; privilégios reais são validados no PostgreSQL.
DB_READ_ONLY=true
AI_ENABLED=false
