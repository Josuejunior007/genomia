APP_NAME=GenomAI API
APP_ENV=development

# =====================================================================
# 1) BANCO ANALISADO (somente leitura)
# Use a URL da role genomia_reader, nunca a role administrativa.
# Guarde URL e senha apenas no .env local ou secret manager; não faça commit.
# Exemplo sem valores reais:
# postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require
# =====================================================================
DATABASE_URL=postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require
DB_SCHEMA=public
# Indicador da aplicação; privilégios reais são garantidos no PostgreSQL.
DB_READ_ONLY=true

# =====================================================================
# 2) ARMAZENAMENTO INTERNO (sugestões, revisões, auditoria)
# Em produção use PostgreSQL com schema próprio e role de escrita dedicada.
# O schema NUNCA pode ser igual ao DB_SCHEMA analisado.
#
# Provisionamento:
#   psql ... -f scripts/app_store_postgres.sql
#   psql ... -f scripts/provision_app_store_role.sql
# Depois defina APP_DB_AUTO_CREATE=false.
#
# Exemplo de produção:
# APP_DATABASE_URL=postgresql+psycopg://genomia_app_writer:<senha>@<host>:5432/<database>?sslmode=require
# APP_DB_SCHEMA=genomai_app
# APP_DB_AUTO_CREATE=false
# APP_STORE_REQUIRE_REMOTE=true
#
# Desenvolvimento local (arquivo no servidor, não no navegador):
APP_DATABASE_URL=sqlite:///./genomai_app.db
APP_DB_SCHEMA=genomai_app
APP_DB_AUTO_CREATE=true
APP_STORE_REQUIRE_REMOTE=false

# Tabelas que nunca entram na análise nem no payload da IA. Inclui as tabelas
# internas do GenomAI e a tabela legada public.suggestions do Supabase.
ANALYSIS_EXCLUDED_TABLES=["suggestions","suggestion_revisions","apply_logs","ai_metadata_audits"]

# =====================================================================
# 3) APLICAÇÃO CONTROLADA DE MUDANÇAS (opcional)
# Só é usada pelo endpoint POST /api/v1/suggestions/{id}/apply.
# Use uma role de DDL dedicada, diferente da role read-only.
# =====================================================================
WRITE_DATABASE_URL=
DB_WRITE_ENABLED=false

# Persona usada quando o cabeçalho X-GenomAI-Persona não é enviado.
# Valores: leitor, analista, desenvolvedor, administrador.
DEFAULT_PERSONA=leitor

# =====================================================================
# 4) IA E PRIVACIDADE
# =====================================================================
AI_ENABLED=false
# Habilite após definir a chave no .env local ou secret manager. Nunca commite a chave.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Se true, nomes de colunas sensíveis são pseudonimizados antes do envio.
PRIVACY_MASK_SENSITIVE_IDENTIFIERS=false
# Se true, sequências de 6+ dígitos em identificadores são redigidas.
PRIVACY_REDACT_DIGIT_RUNS=true

CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
