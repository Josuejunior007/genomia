APP_NAME=GenomAI API
APP_ENV=development

# Use a URL da role PostgreSQL genomia_reader, nunca a role administrativa.
# Guarde URL e senha apenas no .env local ou secret manager; não faça commit.
# Exemplo sem valores reais:
# postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require

# Banco controlado pelo GenomAI: guarda sugestões e decisões de revisão.
# O padrão local usa SQLite. Em produção, use um banco PostgreSQL dedicado.
APP_DATABASE_URL=sqlite:///./genomai_app.db

DB_SCHEMA=public
# Indicador da aplicação; privilégios reais são garantidos no PostgreSQL.
DB_READ_ONLY=true
AI_ENABLED=false
# Habilite após definir a chave no .env local ou secret manager. Nunca commite a chave.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
