APP_NAME=GenomAI API
APP_ENV=development

# Use a URL da role PostgreSQL genomia_reader, nunca a role administrativa.
# Guarde URL e senha apenas no .env local ou secret manager; não faça commit.
# Exemplo sem valores reais:
# postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require
DATABASE_URL=postgresql+psycopg://genomia_reader:<senha>@<host>:5432/<database>?sslmode=require

DB_SCHEMA=public
# Indicador da aplicação; privilégios reais são garantidos no PostgreSQL.
DB_READ_ONLY=true
AI_ENABLED=false
